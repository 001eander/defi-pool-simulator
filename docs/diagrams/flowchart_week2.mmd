flowchart TD
    T1([交易到达<br/>EXPO 5 min]) --> A1["赋属性：类型 60/30/10<br/>方向 A→B / B→A 各半<br/>规模、滑点容忍度"]
    A1 -.-> Q0["队列：无<br/>瞬时结算，不等待"]
    A1 --> D1{"可用储备 ≥ 输入量？"}
    D1 -- 否 --> F1(["放弃：库存不足<br/>计入失败并离开"])
    D1 -- 是 --> C1["按 x·y=k 定价<br/>计算成交价与滑点"]
    C1 --> D2{"滑点 ≤ 容忍度？<br/>1% / 3% / 5%"}
    D2 -- 否 --> F2(["放弃：滑点超限<br/>计入失败并离开"])
    D2 -- 是 --> C2(["成交：更新储备 A/B<br/>手续费 0.3% 回流<br/>记录成交量与滑点后离开"])

    L1(["LP 操作到达<br/>添加 EXPO 2 h / 移除 EXPO 3 h"]) -.-> D3{"添加还是移除？"}
    D3 -- 添加 --> L2(["注入 1—10 万 A<br/>及等值 B"])
    D3 -- 移除 --> L4(["撤出 1—5 万 A<br/>及等值 B"])
    L2 -. 更新池深 .-> S
    L4 -. 更新池深 .-> S

    E1(["外部价格事件<br/>每小时"]) -.-> E2(["随机游走 N(0,2%)<br/>结算无常损失<br/>记录小时快照"])
    E2 -. 市价基准 .-> S

    S[("资源 / 状态<br/>储备 A、储备 B、LP 份额")] -. 池深约束 .-> D1
    S -. 定价基准 .-> C1

    style S fill:#fff3cd,stroke:#d4a017
    style D1 fill:#ffe0e0,stroke:#c0392b
    style D2 fill:#ffe0e0,stroke:#c0392b
